<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:CS2Blocker"
        x:Class="CS2Blocker.SettingsWindow" x:DataType="local:SettingsViewModel" x:CompileBindings="True"
        Title="Valve Blocker Settings" Width="520" Height="450" CanResize="False"
        WindowDecorations="None" TransparencyLevelHint="Transparent" Background="Transparent"
        WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource BlockerFont}" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="BlockerBackground">#101213</SolidColorBrush>
    <SolidColorBrush x:Key="BlockerSurface">#161819</SolidColorBrush>
    <SolidColorBrush x:Key="BlockerBorder">#292D30</SolidColorBrush>
    <SolidColorBrush x:Key="BlockerHover">#222628</SolidColorBrush>
    <SolidColorBrush x:Key="BlockerSelection">#332B1E</SolidColorBrush>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="Border.settingsCard">
      <Setter Property="Background" Value="{DynamicResource BlockerSurface}" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="BorderBrush" Value="{DynamicResource BlockerBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="15" />
    </Style>
    <Style Selector="TextBlock.settingsTitle">
      <Setter Property="Foreground" Value="{DynamicResource BlockerText}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.settingsDetail">
      <Setter Property="Foreground" Value="{DynamicResource BlockerMuted}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.settingsAction">
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Height" Value="38" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="{DynamicResource BlockerBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BlockerBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource BlockerText}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="ActionFrame" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.settingsAction:pointerover /template/ Border#ActionFrame">
      <Setter Property="Background" Value="{DynamicResource BlockerHover}" />
    </Style>
    <Style Selector="Button.settingsAction:pressed /template/ Border#ActionFrame">
      <Setter Property="Background" Value="{DynamicResource BlockerSelection}" />
    </Style>
    <Style Selector="Button.settingsAction:focus-visible /template/ Border#ActionFrame">
      <Setter Property="BorderBrush" Value="{DynamicResource BlockerAccent}" />
    </Style>
    <Style Selector="Button.settingsAction:disabled">
      <Setter Property="Opacity" Value="0.48" />
    </Style>
    <Style Selector="Border.adminBadge">
      <Setter Property="Background" Value="{DynamicResource BlockerHover}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderBrush" Value="{DynamicResource BlockerBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.adminBadge.needed">
      <Setter Property="Background" Value="{DynamicResource BlockerSelection}" />
    </Style>
    <Style Selector="Border.adminBadge.needed TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BlockerAccent}" />
    </Style>
  </Window.Styles>
  <Border Background="{DynamicResource BlockerBackground}" BorderBrush="{DynamicResource BlockerBorder}"
          BorderThickness="1" CornerRadius="15" ClipToBounds="True">
    <Grid RowDefinitions="58,*">
      <Border x:Name="TitleBar"
              BorderBrush="{DynamicResource BlockerBorder}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="30,*,30" Margin="10,0">
          <TextBlock Grid.Column="1" Text="Settings" Classes="settingsTitle" FontSize="19" FontWeight="SemiBold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Button x:Name="SettingsClose" Grid.Column="2" Command="{Binding CloseWindow}" />
        </Grid>
      </Border>
      <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Hidden">
        <StackPanel Spacing="16" Margin="16">
          <Border Classes="settingsCard">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="Start with Windows" Classes="settingsTitle" />
                  <TextBlock Text="{Binding StartupDetail}" Classes="settingsDetail" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartupEnabled, Mode=TwoWay}"
                              IsEnabled="{Binding StartupAvailable}" OnContent="" OffContent=""
                              MinWidth="0" VerticalAlignment="Center" Cursor="Hand"
                              AutomationProperties.Name="Start with Windows" />
              </Grid>
              <Border Height="1" Background="{DynamicResource BlockerBorder}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="Minimize to tray on close" Classes="settingsTitle" />
                  <TextBlock Text="{Binding CloseToTrayDetail}" Classes="settingsDetail" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding CloseToTray, Mode=TwoWay}"
                              OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Cursor="Hand"
                              AutomationProperties.Name="Minimize to tray on close" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Classes="settingsCard">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="3">
                  <TextBlock Text="Administrator access" Classes="settingsTitle" />
                  <TextBlock Text="Required to change firewall rules" Classes="settingsDetail" />
                </StackPanel>
                <Border Grid.Column="1" Classes="adminBadge" Classes.needed="{Binding NeedsAdmin}">
                  <TextBlock Text="{Binding AdminStatus}" Classes="settingsDetail" />
                </Border>
              </Grid>
              <Button Classes="settingsAction" Content="Restart as administrator"
                      Command="{Binding RestartAsAdmin}" IsVisible="{Binding NeedsAdmin}"
                      IsEnabled="{Binding !Busy}" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" />
              <TextBlock Text="{Binding AdminFeedback}" Classes="settingsDetail"
                         IsVisible="{Binding HasAdminFeedback}" />
            </StackPanel>
          </Border>
          <Border Classes="settingsCard">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding VersionLabel}" Classes="settingsTitle" />
                <TextBlock Text="{Binding UpdateStatus}" Classes="settingsDetail" />
              </StackPanel>
              <Button Grid.Column="1" Classes="settingsAction" Content="Check"
                      Command="{Binding CheckUpdates}" IsEnabled="{Binding !Busy}"
                      IsVisible="{Binding CanUpdate}" />
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
